# Copy this file to .env and fill it in. .env is gitignored.
# Never commit the real one.
#
# This holds ONE thing: the connection string used to LOAD the data, once,
# before the session. Querying during the session goes through the Supabase
# MCP server instead, which authenticates with OAuth and needs no token here.
#
# Where to find it: Supabase dashboard, your project, the Connect button at the
# top of the page. Choose "Session pooler", not Direct. Direct connections are
# IPv6 only unless you pay for the IPv4 add on, and most laptops and nearly all
# conference wifi are IPv4. Port 5432.
#
# postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
#
# Percent encode any @ : or / inside your password.

SUPABASE_DB_URL=
